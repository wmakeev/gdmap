dnl Process this file with autoconf to produce a configure script.

AC_INIT(configure.in)

AM_INIT_AUTOMAKE(gdmap, 0.3)
AM_CONFIG_HEADER(config.h)

AM_MAINTAINER_MODE

dnl AM_PROG_LIBTOOL

AC_CHECK_TOOL(RANLIB, ranlib)

AC_ISC_POSIX
AC_PROG_CC
AM_PROG_CC_STDC
AC_PROG_INSTALL
AC_PROG_MAKE_SET
AC_HEADER_STDC
AC_ARG_PROGRAM

AC_C_BIGENDIAN

AC_CYGWIN
AC_MINGW32

AC_HEADER_STDC

AC_CHECK_HEADERS(unistd.h)

dnl pkg_modules="libxml-2.0 >= 2.0.0"
dnl PKG_CHECK_MODULES(LIBXML, [$pkg_modules])
dnl AC_SUBST(LIBXML_CFLAGS)
dnl AC_SUBST(LIBXML_LIBS)

dnl Use -Wall if we have gcc.
if test "x$GCC" = "xyes"; then
  case " $CFLAGS " in
  [*[\ \	]-Wall[\ \	]*]) ;;
  *) CFLAGS="$CFLAGS -W -Wall" ;;
  esac
  CFLAGS="$CFLAGS -D_GNU_SOURCE"
fi

pkg_modules="gtk+-2.0 >= 2.0.0"
PKG_CHECK_MODULES(UI, [$pkg_modules])
AC_DEFINE(GTK_DISABLE_DEPRECATED, TRUE, [gtk+1.2 is not allowed])

AC_SUBST(UI_CFLAGS)
AC_SUBST(UI_LIBS)

AC_OUTPUT([
Makefile
src/Makefile
])
